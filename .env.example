# --- Trading mode ---
# false = paper (orders only logged, no real placement)
# true  = real market orders
LIVE_TRADING=false

# --- Capital & risk ---
# 4% daily loss kill-switch (hard-coded in main.py as well, this is the config value)
DAILY_LOSS_LIMIT_PCT=4.0

# Max instruments allowed (hard limit)
MAX_INSTRUMENTS=6

# --- Leverage multiplier when CSV says leverage=true ---
LEVERAGE_MULTIPLIER=5

# --- ntfy.sh ---
NTFY_TOPIC=live_trading_setup_mritunjay
NTFY_SERVER=https://ntfy.sh

# --- Paths (inside container) ---
INSTRUMENTS_CSV=/app/filtered_stocks.csv
STATE_DIR=/app/state
LOG_DIR=/app/logs
DATA_DIR=/app/data

# --- Metrics ---
METRICS_PORT=8000

# --- Optional: override square-off time (HH:MM IST) ---
SQUARE_OFF_TIME=15:14

# --- Timezone ---
TZ=Asia/Kolkata
