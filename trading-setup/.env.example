# ---------- Broker APIs ----------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Which provider does what. Options: upstox | dhan
DATA_PROVIDER=upstox
ORDER_PROVIDER=dhan

# ---------- Notifications ----------
NTFY_TOPIC=your-private-ntfy-topic-name
NTFY_SERVER=https://ntfy.sh

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Dashboard OTP login (Gmail SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-bot-account@gmail.com
SMTP_APP_PASSWORD=your-16-char-gmail-app-password
OTP_EXPIRY_MINUTES=10
DASHBOARD_JWT_SECRET=change-this-to-a-long-random-string

# ---------- Grafana ----------
GRAFANA_ADMIN_PASSWORD=change-this

# ---------- Risk controls (enforced in execution-gate, not optional) ----------
MAX_DAILY_LOSS_INR=5000
MAX_OPEN_POSITIONS=10
KILL_SWITCH=false
